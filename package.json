{
  "name": "schwab-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A security-focused, self-hosted Schwab MCP server for Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "deploy": "wrangler deploy --config wrangler.local.jsonc",
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "supply-chain": "npm audit --omit=dev --audit-level=high && npm audit signatures",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
