{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schwab-mcp-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "disallow_importable_env",
  ],
  "workers_dev": false,
  "vars": {
    "MCP_RESOURCE_URL": "https://REPLACE_WITH_PREVIEW_WORKER_HOSTNAME/mcp",
    "TRADING_MODE": "preview",
    "SCHWAB_ENVIRONMENT": "production",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "TOKEN_VAULT", "class_name": "SchwabTokenVault" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SchwabTokenVault"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
}
